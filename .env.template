# 1Password env template for the Vedette.
# Use with: op run --env-file=.env.template -- <command>
# or:       op inject -i .env.template -o .env
# Values are 1Password references (op://vault/item/field), never real secrets.
# Never commit a rendered .env.

# Model API keys (only the one matching your research_backend.provider is needed)
OPENAI_API_KEY="op://Private/OpenAI/API key"
ANTHROPIC_API_KEY="op://Private/Anthropic/API key"

# Built-in web-search providers (optional; keyless DuckDuckGo is the default).
# Set one to upgrade research-leg search quality. Only needed when
# search.provider in config.yaml is set to serper/bing (or auto picks them up).
SERPER_API_KEY="op://Private/Vedette/Serper API key"
BING_API_KEY="op://Private/Vedette/Bing API key"

# Optional threat-intel enrichers (all skipped gracefully without a key):
# HaveIBeenPwned breach lookup for email targets, VirusTotal domain reports,
# AlienVault OTX pulses for domain targets.
HIBP_API_KEY="op://Private/Vedette/HIBP API key"
VT_API_KEY="op://Private/Vedette/VirusTotal API key"
OTX_API_KEY="op://Private/Vedette/OTX API key"

# Web GUI: Google OAuth
OSINT_GOOGLE_CLIENT_ID="op://Private/Vedette/Google client ID"
OSINT_GOOGLE_CLIENT_SECRET="op://Private/Vedette/Google client secret"
OSINT_ALLOWED_GOOGLE_EMAILS="op://Private/Vedette/allowed Google emails"

# Web GUI: generic OIDC SSO (alternative to Google)
OSINT_OIDC_CLIENT_ID="op://Private/Vedette/OIDC client ID"
OSINT_OIDC_CLIENT_SECRET="op://Private/Vedette/OIDC client secret"
OSINT_ALLOWED_EMAILS="op://Private/Vedette/allowed emails"
OSINT_ALLOWED_DOMAINS="op://Private/Vedette/allowed domains"

# Web GUI: session signing key (random 32+ chars)
OSINT_SESSION_SECRET="op://Private/Vedette/session secret"

# Optional local PostgreSQL activity journal (example: postgresql://localhost/vedette)
# DATABASE_URL=postgresql://localhost/vedette

# Web GUI: local password failover (used when no OAuth/OIDC is configured)
OSINT_LOCAL_PASSWORD="op://Private/Vedette/local password"
